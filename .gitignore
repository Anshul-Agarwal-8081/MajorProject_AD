# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8 
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# ----------------------------------------------------------------
# WEB PREVIEW — local only, never committed to git
# This project is a MOBILE app. Web preview is for quick testing.
# ----------------------------------------------------------------

# Web packages are installed with --no-save so package.json stays
# mobile-only. The script that does this is also excluded:
start-web.sh

# Web build output folders
/web-build/
/dist/

# package-lock changes from npm --no-save installs
package-lock.json

# Backend environment secrets
/server/.env
/server/.env.*
!/server/.env.example

# Keep backend dependency lockfile
!/server/package-lock.json
