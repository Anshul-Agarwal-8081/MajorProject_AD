# Copy this file to .env and replace the placeholders on your own computer.
# Never commit server/.env or put this database URL in the Expo mobile app.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/coastsafe_india
HOST=0.0.0.0
PORT=3000
# Optional for managed PostgreSQL providers that require TLS.
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Optional pool size override (default: 10).
# PGPOOL_MAX=10
